// File name: projects/3/a/RAM64.hdl
/**
 * Memory of sixty four 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM64 {
    IN in[16], load, address[6];
    OUT out[16];

    PARTS:
    DMux8Way(in=load , sel[0]=address[5],sel[1]=address[4],sel[2]=address[3] , a=a , b=b , c=c , d= d, e=e , f= f, g=g , h=h );  

    RAM8(in=in , load=a , address[0]=address[0],address[1]=address[1],address[2]=address[2] , out= r1);
    RAM8(in=in , load=b , address[0]=address[0],address[1]=address[1],address[2]=address[2] , out= r2);
    RAM8(in=in , load=c , address[0]=address[0],address[1]=address[1],address[2]=address[2] , out= r3);
    RAM8(in=in , load=d , address[0]=address[0],address[1]=address[1],address[2]=address[2] , out= r4);
    RAM8(in=in , load=e , address[0]=address[0],address[1]=address[1],address[2]=address[2] , out= r5);
    RAM8(in=in , load=f , address[0]=address[0],address[1]=address[1],address[2]=address[2] , out= r6);
    RAM8(in=in , load=g , address[0]=address[0],address[1]=address[1],address[2]=address[2] , out= r7);
    RAM8(in=in , load=h , address[0]=address[0],address[1]=address[1],address[2]=address[2] , out= r8);
    Mux8Way16(a=r1 , b=r2 , c=r3 , d=r4 , e=r5 , f=r6 , g=r7 , h=r8 , sel[0]=address[5],sel[1]=address[4],sel[2]=address[3] , out=out );

}