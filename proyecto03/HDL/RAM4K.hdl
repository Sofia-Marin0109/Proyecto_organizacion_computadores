// File name: projects/3/b/RAM4K.hdl
/**
 * Memory of 4K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];
    
    PARTS:
    DMux8Way(in=load , sel[0]=address[11],sel[1]=address[10],sel[2]=address[9] , a=a , b=b , c=c , d=d , e=e , f=f , g=g , h=h );
    
    RAM512(in=in , load=a , address[0]=address[8],address[1]=address[7],address[2]=address[6],address[3]=address[5],address[4]=address[4],address[5]=address[3],address[6]=address[2],address[7]=address[1],address[8]=address[0] , out=a1 );
    RAM512(in=in , load=b , address[0]=address[8],address[1]=address[7],address[2]=address[6],address[3]=address[5],address[4]=address[4],address[5]=address[3],address[6]=address[2],address[7]=address[1],address[8]=address[0] , out=b1 );
    RAM512(in=in , load=c , address[0]=address[8],address[1]=address[7],address[2]=address[6],address[3]=address[5],address[4]=address[4],address[5]=address[3],address[6]=address[2],address[7]=address[1],address[8]=address[0] , out=c1 );
    RAM512(in=in , load=d , address[0]=address[8],address[1]=address[7],address[2]=address[6],address[3]=address[5],address[4]=address[4],address[5]=address[3],address[6]=address[2],address[7]=address[1],address[8]=address[0] , out=d1 );
    RAM512(in=in , load=e , address[0]=address[8],address[1]=address[7],address[2]=address[6],address[3]=address[5],address[4]=address[4],address[5]=address[3],address[6]=address[2],address[7]=address[1],address[8]=address[0] , out=e1 );
    RAM512(in=in , load=f , address[0]=address[8],address[1]=address[7],address[2]=address[6],address[3]=address[5],address[4]=address[4],address[5]=address[3],address[6]=address[2],address[7]=address[1],address[8]=address[0] , out=f1 );
    RAM512(in=in , load=g , address[0]=address[8],address[1]=address[7],address[2]=address[6],address[3]=address[5],address[4]=address[4],address[5]=address[3],address[6]=address[2],address[7]=address[1],address[8]=address[0] , out=g1 );
    RAM512(in=in , load=h , address[0]=address[8],address[1]=address[7],address[2]=address[6],address[3]=address[5],address[4]=address[4],address[5]=address[3],address[6]=address[2],address[7]=address[1],address[8]=address[0] , out=h1 );

    Mux8Way16(a=a1 , b=b1 , c=c1 , d=d1 , e=e1 , f=f1 , g=g1 , h=h1 , sel[0]=address[11],sel[1]=address[10],sel[2]=address[9] , out=out );
}