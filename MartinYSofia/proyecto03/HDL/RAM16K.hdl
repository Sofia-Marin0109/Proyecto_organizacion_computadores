// File name: projects/3/b/RAM16K.hdl
/**
 * Memory of 16K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:

    DMux8Way(in=load , sel[0]=address[13],sel[1]=address[12],sel[2]=address[11] , a=a , b=b , c=c , d=d , e=e , f=f , g=g , h=h );

    RAM4K(in=in , load=a,
    address[0]  = address[10],
    address[1]  = address[9],
    address[2]  = address[8],
    address[3]  = address[7],
    address[4]  = address[6],
    address[5]  = address[5],
    address[6] = address[4],
    address[7] = address[3],
    address[8] = address[2],
    address[9] = address[1],
    address[10] = address[0], out=a1 );

    RAM4K(in=in , load=b,
    address[0]  = address[10],
    address[1]  = address[9],
    address[2]  = address[8],
    address[3]  = address[7],
    address[4]  = address[6],
    address[5]  = address[5],
    address[6] = address[4],
    address[7] = address[3],
    address[8] = address[2],
    address[9] = address[1],
    address[10] = address[0], out=b1 );

    RAM4K(in=in , load=c,
    address[0]  = address[10],
    address[1]  = address[9],
    address[2]  = address[8],
    address[3]  = address[7],
    address[4]  = address[6],
    address[5]  = address[5],
    address[6] = address[4],
    address[7] = address[3],
    address[8] = address[2],
    address[9] = address[1],
    address[10] = address[0], out=c1 );

    RAM4K(in=in , load=d,
    address[0]  = address[10],
    address[1]  = address[9],
    address[2]  = address[8],
    address[3]  = address[7],
    address[4]  = address[6],
    address[5]  = address[5],
    address[6] = address[4],
    address[7] = address[3],
    address[8] = address[2],
    address[9] = address[1],
    address[10] = address[0], out=d1 );

    RAM4K(in=in , load=e,
    address[0]  = address[10],
    address[1]  = address[9],
    address[2]  = address[8],
    address[3]  = address[7],
    address[4]  = address[6],
    address[5]  = address[5],
    address[6] = address[4],
    address[7] = address[3],
    address[8] = address[2],
    address[9] = address[1],
    address[10] = address[0], out=e1 );

        RAM4K(in=in , load=f,
    address[0]  = address[10],
    address[1]  = address[9],
    address[2]  = address[8],
    address[3]  = address[7],
    address[4]  = address[6],
    address[5]  = address[5],
    address[6] = address[4],
    address[7] = address[3],
    address[8] = address[2],
    address[9] = address[1],
    address[10] = address[0], out=f1 );


    RAM4K(in=in , load=g,
    address[0]  = address[10],
    address[1]  = address[9],
    address[2]  = address[8],
    address[3]  = address[7],
    address[4]  = address[6],
    address[5]  = address[5],
    address[6] = address[4],
    address[7] = address[3],
    address[8] = address[2],
    address[9] = address[1],
    address[10] = address[0], out=g1 );

    RAM4K(in=in , load=h,
    address[0]  = address[10],
    address[1]  = address[9],
    address[2]  = address[8],
    address[3]  = address[7],
    address[4]  = address[6],
    address[5]  = address[5],
    address[6] = address[4],
    address[7] = address[3],
    address[8] = address[2],
    address[9] = address[1],
    address[10] = address[0], out=h1 );

    Mux8Way16(a=a1 , b=b1 , c=c1 , d=d1 , e=e1 , f=f1 , g=g1 , h=h1 , sel[0]=address[13],sel[1]=address[12],sel[2]=address[11] , out=out );
}