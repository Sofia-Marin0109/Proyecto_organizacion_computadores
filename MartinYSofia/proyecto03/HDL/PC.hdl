// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    
    //definimos la variable del inc
    Inc16(in=o1 , out=outINC );
    //la variable del load es in[16]
    Mux16(a=o1, b=outINC  , sel=inc , out=p);

    Mux16(a=p, b=in, sel=load , out=p2 );
    
    Mux16(a=p2 , b=false, sel=reset , out=p3 );
    
    Register(in=p3 , load=true , out=out,out=o1);
    
}