// Carrera.jack - Lógica del juego de carriles (sección 8 del enunciado).
// No dibuja ni lee el teclado: solo guarda y actualiza el estado de la carrera.
// Autor: Sofía Marín Bustamante

class Carrera {
    field int pasosMeta, progreso, puntaje, estado, vidas, carrilCarro;
    field int cantObstaculos, dirPendiente;
    field Array obstaculos;

    // carrera nueva: carro en el carril 1, 3 vidas, puntaje y progreso en 0, sin obstáculos
    constructor Carrera new(int pMeta, int semilla) {
        let pasosMeta = pMeta;
        let carrilCarro = 1;
        let vidas = 3;
        let puntaje = 0;
        let progreso = 0;
        let estado = 0;
        let cantObstaculos = 0;
        let dirPendiente = 0;
        let obstaculos = Array.new(20);
        do Aleatorio.semilla(semilla);
        return this;
    }

    // libera los obstáculos que quedan, el arreglo y la carrera
    method void dispose() {
        var Obstaculo obs;
        while (cantObstaculos > 0) {
            let cantObstaculos = cantObstaculos - 1;
            let obs = obstaculos[cantObstaculos];
            do obs.dispose();
        }
        do obstaculos.dispose();
        do Memory.deAlloc(this);
        return;
    }

    // guarda la solicitud de cambio de carril (-1 sube, 1 baja); se aplica en el siguiente avanzar
    method void moverCarro(int dir) {
        if ((estado = 0) & ((dir = 1) | (dir = -1))) { let dirPendiente = dir; }
        return;
    }

    // agrega un obstáculo con su celda izquierda en col si hay espacio y el tipo y el carril son válidos
    method void agregarObstaculo(int tipo, int carril, int col) {
        if ((cantObstaculos < 20) & (carril > -1) & (carril < 3) & (tipo > -1) & (tipo < 4)) {
            let obstaculos[cantObstaculos] = Obstaculo.new(tipo, carril, col);
            let cantObstaculos = cantObstaculos + 1;
        }
        return;
    }

    // un paso del juego, en el orden de la sección 8.3
    method void avanzar() {
        var int carrilNuevo;
        if (~(estado = 0)) { return; }
        // 1. cambio de carril
        let carrilNuevo = carrilCarro + dirPendiente;
        if ((carrilNuevo > -1) & (carrilNuevo < 3)) { let carrilCarro = carrilNuevo; }
        let dirPendiente = 0;
        // 2. y 3. primero se mueven todos y después se revisan los choques
        do moverObstaculos();
        do revisarChoques();
        // 4., 5. y 6. solo si no perdió en los choques (si perdió, el paso termina ahí)
        if (estado = 0) {
            do revisarSalidas();
            let progreso = progreso + 1;
            let puntaje = puntaje + 1;
            if (progreso = pasosMeta) { let estado = 2; }
        }
        do eliminarInactivos();
        return;
    }

    // mueve cada obstáculo a la izquierda según su velocidad
    method void moverObstaculos() {
        var int i;
        var Obstaculo obs;
        let i = 0;
        while (i < cantObstaculos) {
            let obs = obstaculos[i];
            do obs.mover();
            let i = i + 1;
        }
        return;
    }

    // revisa qué obstáculos del carril del carro pasaron por la columna 2 (la del carro)
    method void revisarChoques() {
        var int i;
        var Obstaculo obs;
        let i = 0;
        while ((i < cantObstaculos) & (estado = 0)) {
            let obs = obstaculos[i];
            if ((obs.getCarril() = carrilCarro) & obs.pasoPor(2)) { do chocar(obs); }
            let i = i + 1;
        }
        return;
    }

    // efecto de un choque: la moneda suma 10 y los demás quitan una vida; el obstáculo se elimina
    method void chocar(Obstaculo obs) {
        if (obs.getTipo() = 3) {
            let puntaje = puntaje + 10;
        } else {
            let vidas = vidas - 1;
            if (vidas = 0) { let estado = 1; }
        }
        do obs.desactivar();
        return;
    }

    // desactiva los obstáculos que salieron completos por la izquierda
    method void revisarSalidas() {
        var int i;
        var Obstaculo obs;
        let i = 0;
        while (i < cantObstaculos) {
            let obs = obstaculos[i];
            if (obs.salio()) { do obs.desactivar(); }
            let i = i + 1;
        }
        return;
    }

    // libera los inactivos y corre los activos al inicio del arreglo (sección 8.5)
    method void eliminarInactivos() {
        var int i, j;
        var Obstaculo obs;
        let i = 0;
        let j = 0;
        while (i < cantObstaculos) {
            let obs = obstaculos[i];
            if (obs.isActivo()) {
                let obstaculos[j] = obs;
                let j = j + 1;
            } else {
                do obs.dispose();
            }
            let i = i + 1;
        }
        let cantObstaculos = j;
        return;
    }

    // agrega a lo sumo un obstáculo en la columna 31 (sección 8.4)
    method void generar() {
        var int carril, tipo;
        if (~(estado = 0)) { return; }
        // solo se intenta más o menos en 1 de cada 3 pasos para que la vía no se llene
        if (~(azar(3) = 0)) { return; }
        let carril = azar(3);
        let tipo = azar(4);
        if (ocupada(carril, 31) = -1) {
            // las monedas no son letales, entonces no necesitan la regla de paso libre
            if ((tipo = 3) | pasoLibre(carril)) { do agregarObstaculo(tipo, carril, 31); }
        }
        return;
    }

    // número pseudoaleatorio entre 0 y n - 1
    method int azar(int n) {
        var int r;
        // & 32767 quita el bit de signo y / 128 deja los bits altos (los bajos se repiten muy rápido)
        let r = (Aleatorio.siguiente() & 32767) / 128;
        // residuo de r entre n con restas
        while (~(r < n)) { let r = r - n; }
        return r;
    }

    // regla de paso libre: true si alguno de los otros dos carriles no tiene letales entre 26 y 31
    method boolean pasoLibre(int carril) {
        var int c;
        let c = 0;
        while (c < 3) {
            if ((~(c = carril)) & (~tieneLetal(c))) { return true; }
            let c = c + 1;
        }
        return false;
    }

    // true si el carril tiene un obstáculo letal (tipo 0, 1 o 2) en alguna columna entre 26 y 31
    method boolean tieneLetal(int carril) {
        var int col, tipo;
        let col = 26;
        while (col < 32) {
            let tipo = ocupada(carril, col);
            if ((tipo > -1) & (tipo < 3)) { return true; }
            let col = col + 1;
        }
        return false;
    }

    // tipo del obstáculo que ocupa (carril, col), o -1 si está libre o col está fuera de 0 a 31
    method int ocupada(int carril, int col) {
        var int i;
        var Obstaculo obs;
        if ((col < 0) | (col > 31)) { return -1; }
        let i = 0;
        while (i < cantObstaculos) {
            let obs = obstaculos[i];
            if (obs.isActivo() & (obs.getCarril() = carril) & obs.ocupa(col)) { return obs.getTipo(); }
            let i = i + 1;
        }
        return -1;
    }

    method int carrilCarro() { return carrilCarro; }
    method int vidas() { return vidas; }
    method int puntaje() { return puntaje; }
    method int progreso() { return progreso; }
    method int estado() { return estado; }
    method int cantidad() { return cantObstaculos; }
    method int meta() { return pasosMeta; }
    method Obstaculo obstaculo(int i) { return obstaculos[i]; }
}
