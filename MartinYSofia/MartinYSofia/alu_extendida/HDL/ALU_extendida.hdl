// File name: projects/2/ALU.hdl
/**
 * ALU (Arithmetic Logic Unit):
 * Computes out = one of the following functions:
 *                0, 1, -1,
 *                x, y, !x, !y, -x, -y,
 *                x + 1, y + 1, x - 1, y - 1,
 *                x + y, x - y, y - x,
 *                x & y, x | y
 * on the 16-bit inputs x, y,
 * according to the input bits zx, nx, zy, ny, f, no.
 * In addition, computes the two output bits:
 * if (out == 0) zr = 1, else zr = 0
 * if (out < 0)  ng = 1, else ng = 0
 */
// Implementation: Manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) sets x = 0        // 16-bit constant
// if (nx == 1) sets x = !x       // bitwise not
// if (zy == 1) sets y = 0        // 16-bit constant
// if (ny == 1) sets y = !y       // bitwise not
// if (f == 1)  sets out = x + y  // integer 2's complement addition
// if (f == 0)  sets out = x & y  // bitwise and
// if (no == 1) sets out = !out   // bitwise not

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs   
        a,  // requerida por el profesor
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:
    //if (zx == 1) sets x = 0
    Mux16(a=x, b=false, sel=zx, out=x0);

    //if (nx == 1) sets x = !x
    Not16(in=x0, out=ntx0);
    Mux16(a=x0, b=ntx0, sel=nx, out=x1);

    // if (zy == 1) sets y = 0        
    Mux16(a=y, b=false, sel=zy, out=y0);

    // if (ny == 1) sets y = !y     
    Not16(in=y0, out=nty0);
    Mux16(a=y0, b=nty0, sel=ny, out=y1);

    //CÁLCULO DE ALU EXTENDIDA
    Not(in=zx, out=notzx);
    Not(in=nx, out=notnx);
    
    Not(in=zy, out=notzy);
    Not(in=ny, out=notny);

    Not(in=f, out=notf);
    Not(in=no, out=notno);

    // XOR
    And(a=notzx, b=nx, out=andntznx);
    And(a=andntznx, b=notzy, out=andntznxzy);
    And(a=andntznxzy, b=ny, out=andntzxynxy);
    And(a=andntzxynxy, b=f, out=andntzxynxyf);
    And(a=andntzxynxyf, b=notno, out=RXOR);

    // NAND
    And(a=notzx, b=notnx , out=andntznx1);
    And(a=andntznx1, b=notzy, out=andntzxyn);
    And(a=andntzxyn, b=notny, out=andntzxyny);
    And(a=andntzxyny, b=notf, out=andntfzxyny);
    And(a=andntfzxyny, b=no, out=RNAND);

    // NOR
    And(a=zx, b=nx, out=andznx);
    And(a=andznx, b=notzy, out=andznxntzy);
    And(a=andznxntzy, b=ny, out=andznxnytzy);
    And(a=andznxnytzy, b=notf, out=andznxnytzyf);
    And(a=andznxnytzyf, b=notno, out=RNOR);

    // EQ
    And(a=zx, b=notnx, out=andzxntnx);
    And(a=andzxntnx, b=zy, out=andzxyntnx);
    And(a=andzxyntnx, b=notny, out=andzxyntnxy);
    And(a=andzxyntnxy, b=notf, out=andzxyntnxyf);
    And(a=andzxyntnxyf, b=notno, out=REQ);

    //ABS
    And(a=zx, b=notnx, out=andntzxnx);
    And(a=andntzxnx, b=notzy, out=andntzxynx);
    And(a=andntzxynx, b=notny, out=andntzxnxy);
    And(a=andntzxnxy, b=f, out=andfntzxnxy);
    And(a=andfntzxnxy, b=notno, out=RABS);


    //ALU EXTENDIDA XOR
    Xor16(a=x, b=y, out=xorout);
    Mux16(a=false, b=xorout, sel=RXOR, out=Rxor);

    //ALU EXTENDIDA NAND
    And16(a=x, b=y, out=nandout);
    Mux16(a=Rxor, b=nandout1, sel=RNAND, out=Rnand);

    //ALU EXTENDIDA NOR
    Or16(a=x, b=y, out=orout);
    Not16(in=orout, out=norout);
    Mux16(a=Rnand, b=norout, sel=RNOR, out=Rnor);

    //ALU EXTENDIDA EQ
    Inc16(in=false, out=uno);

    Xor16(a=x, b=y, out=xequal, out[0..7]=xinf, out[8..15]=xsup);
    Or8Way(in=xinf, out=or1); 
    Or8Way(in=xsup, out=or2);
    Or(a=or1, b=or2, out=notequal);
    Not(in=notequal, out=isequal);
    Mux16(a=false, b=uno, sel=isequal, out=eqout);

    Mux16(a=Rnor, b=eqout, sel=REQ, out=Req);
    
    // ALU EXTENDIDA ABS
    Not16(in=x, out=ntx1);
    Inc16(in=ntx1, out=ngtx1);
    Mux16(a=x , b=ngtx1 , sel=x[15] , out=abs);

    Mux16(a=Req, b=abs, sel=RABS, out=Rabs);

    // if (f == 1)  sets out = x + y
    // if (f == 0)  sets out = x & y
    And16(a=x1, b=y1, out=andxy);
    Add16(a=x1, b=y1, out=addxy);
    Mux16(a=andxy, b=addxy, sel=f, out=outf);


    //Eleccon ALU
    Or(a=RXOR, b=RNAND, out=orxornand);
    Or(a=orxornand, b=RNOR, out=orxornandnor);
    Or(a=orxornandnor, b=REQ, out=orxornandnoreq);
    Or(a=orxornandnoreq, b=RABS, out=selectALU);
    Mux16(a=outf, b=Rabs, sel=selectALU, out=outALU);

    //if (no == 1) sets out = !out
    //ng: if (out < 0)  equals 1, else 0
    Not16(in=outALU, out=ntoutALU);
    Mux16(a=outALU, b=ntoutALU, sel=no, out=out, out[0..7]=begin, out[8..15]=end, out[15]=ng);

    // zr: if (out == 0) equals 1, else 0
    Or8Way(in=begin, out=or11);
    Or8Way(in=end, out=or21);
    Or(a=or11, b=or21, out=nt0);
    Not(in=nt0, out=zr);

}