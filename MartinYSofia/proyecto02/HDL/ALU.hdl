// File name: projects/2/ALU.hdl
/**
 * ALU (Arithmetic Logic Unit):
 * Computes out = one of the following functions:
 *                0, 1, -1,
 *                x, y, !x, !y, -x, -y,
 *                x + 1, y + 1, x - 1, y - 1,
 *                x + y, x - y, y - x,
 *                x & y, x | y
 * on the 16-bit inputs x, y,
 * according to the input bits zx, nx, zy, ny, f, no.
 * In addition, computes the two output bits:
 * if (out == 0) zr = 1, else zr = 0
 * if (out < 0)  ng = 1, else ng = 0
 */
// Implementation: Manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) sets x = 0        // 16-bit constant
// if (nx == 1) sets x = !x       // bitwise not
// if (zy == 1) sets y = 0        // 16-bit constant
// if (ny == 1) sets y = !y       // bitwise not
// if (f == 1)  sets out = x + y  // integer 2's complement addition
// if (f == 0)  sets out = x & y  // bitwise and
// if (no == 1) sets out = !out   // bitwise not

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:
    //if (zx == 1) sets x = 0
    Mux16(a=x, b=false, sel=zx, out=x0); // Si sel = 0 elige a, si sel = 1 elige b y false es 16 bits de 0

    //if (nx == 1) sets x = !x
    Not16(in=x0, out=ntx0); // niega la entrada (que es la salida de arriba)
    Mux16(a=x0, b=ntx0, sel=nx, out=x1); // en b esta la salida del not (esta la variable negada) y en a la que salio de la funcion de arriba, si es el sel es 1 sale b que es sin negar, sino sale la negada

    // if (zy == 1) sets y = 0        
    Mux16(a=y, b=false, sel=zy, out=y0);  //igual que las x

    // if (ny == 1) sets y = !y     
    Not16(in=y0, out=nty0);
    Mux16(a=y0, b=nty0, sel=ny, out=y1);

    // if (f == 1)  sets out = x + y
    // if (f == 0)  sets out = x & y
    And16(a=x1, b=y1, out=andxy);  // El and de 16 va comparando bit a bit de a y b y va realizando el and entre cada uno, resultando al final en una salida 16 bits con 1 solo donde a y b tenian ambos 1 en esa posicion
    Add16(a=x1, b=y1, out=addxy);  // El add realiza lo mismo que el and pero suma bit a bit de x mas el de y + el acarreo 
    Mux16(a=andxy, b=addxy, sel=f, out=outf); // el resultado de la suma esta en b de modo que si sel (f) es 1 entonces se elige la suma y si es 0 se elige a que seria el &

    //if (no == 1) sets out = !out
    Not16(in=outf, out=ntoutf); // niega la salida del mux anterior (either la salida del + o del &)
    Mux16(a=outf, b=ntoutf, sel=no, out=out, out[0..7]=begin, out[8..15]=end, out[15]=ng0); //elige entre la negacion o el no negado y define variables 

    // ZONA DE FLAGS

    // zr: if (out == 0) equals 1, else 0
    Or8Way(in=begin, out=or1); // procesa la mitad menos significativa de 8 bits (de der a izq)  y recoge 8 bits en 1 solo, que es 0 si todos son 0 o 1 si hay al menos un 1
    Or8Way(in=end, out=or2); // igual pero con la más significativa, los ultimos 8 bit
    Or(a=or1, b=or2, out=nt0); // recoge los dos bits anteriores y los simplifica a un solo bit
    Not(in=nt0, out=zr); // para lograr el 1 y si no 0 que pide la condicion de out==0

    // ng: if (out < 0)  equals 1, else 0
    And(a=ng0, b=true, out=ng); // 

}